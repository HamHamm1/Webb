# ───────────────────────────────────────────────────────────────
# Hammie World — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ───────────────────────────────────────────────────────────────

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Browser-safe key (respects RLS). New format: sb_publishable_…
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only key. Bypasses RLS — keep secret, never expose to the client.
# New format: sb_secret_…  (legacy SUPABASE_SERVICE_ROLE_KEY also accepted)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Discord webhook for new-order / slip notifications (server-only).
# Can also be stored in store_settings.discord_webhook_url instead.
DISCORD_WEBHOOK_URL=

# Customer login domain. Customers log in with an API code; internally we
# map it to <code>@<this-domain> so we can use Supabase Auth email+password.
# Use any domain you control or a placeholder you keep consistent.
AUTH_EMAIL_DOMAIN=hammie.local

# Storage bucket name for payment slips (created by the migration).
SLIP_BUCKET=slips
